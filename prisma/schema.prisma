datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OPERATOR
  AUDITOR
}

enum AccountStatus {
  CREATED
  WARMING
  ACTIVE
  COOLDOWN
  RESTRICTED
  BANNED
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS5
}

enum ProxyStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  OFFLINE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  CAMPAIGN
  ACCOUNT_CREATION
  PUBLISH
  EMERGENCY_OVERRIDE
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RUNNING
  PAUSED
  COMPLETED
}

enum CampaignActionType {
  LIKE
  COMMENT
  SAVE
  SHARE
  VIEW
  LIVE_VIEW
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(OPERATOR)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  approvals    Approval[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PlatformAccount {
  id                String           @id @default(cuid())
  platform          String           @default("TIKTOK")
  username          String           @unique
  encryptedPassword String?
  encryptedCookies  String?
  status            AccountStatus    @default(CREATED)
  healthScore       Int              @default(100)
  actionsToday      Int              @default(0)
  dailyCap          Int              @default(80)
  lastActiveAt      DateTime?
  proxyId           String?
  proxy             Proxy?           @relation(fields: [proxyId], references: [id])
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  campaignActions   CampaignAction[]
  publishJobs       PublishJob[]

  @@index([status])
  @@index([proxyId])
}

model Proxy {
  id                String            @id @default(cuid())
  protocol          ProxyProtocol     @default(HTTP)
  host              String
  port              Int
  username          String?
  encryptedPassword String?
  country           String?
  latencyMs         Int?
  status            ProxyStatus       @default(HEALTHY)
  consecutiveErrors Int               @default(0)
  lastCheckedAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  accounts          PlatformAccount[]

  @@unique([host, port, username])
  @@index([status])
}

model MediaAsset {
  id              String       @id @default(cuid())
  storageKey      String       @unique
  mimeType        String
  fileSizeBytes   Int
  checksumSha256  String
  durationSeconds Float?
  width           Int?
  height          Int?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  publishJobs     PublishJob[]
}

model Job {
  id          String    @id @default(cuid())
  name        String
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt, priority])
  @@index([lockedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  operatorId   String?
  operator     User?    @relation(fields: [operatorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  metadata     Json?

  @@index([timestamp])
  @@index([action])
  @@index([resourceType, resourceId])
}

model Approval {
  id          String         @id @default(cuid())
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  resourceId  String
  operatorId  String?
  operator    User?          @relation(fields: [operatorId], references: [id])
  notes       String?
  decidedAt   DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  campaigns   Campaign[]
  publishJobs PublishJob[]

  @@index([status])
  @@index([type, resourceId])
}

model Campaign {
  id               String             @id @default(cuid())
  title            String
  targetUrl        String
  actionType       CampaignActionType
  targetCount      Int
  executedCount    Int                @default(0)
  status           CampaignStatus     @default(PENDING_APPROVAL)
  approvalId       String?
  approval         Approval?          @relation(fields: [approvalId], references: [id])
  metadata         Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  actions          CampaignAction[]

  @@index([status])
}

model CampaignAction {
  id          String             @id @default(cuid())
  campaignId  String
  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId   String
  account     PlatformAccount    @relation(fields: [accountId], references: [id])
  actionType  CampaignActionType
  status      JobStatus          @default(PENDING)
  executedAt  DateTime?
  error       String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([campaignId])
  @@index([accountId])
  @@index([status])
}

model PublishJob {
  id           String         @id @default(cuid())
  accountId    String
  account      PlatformAccount @relation(fields: [accountId], references: [id])
  mediaAssetId String
  mediaAsset   MediaAsset     @relation(fields: [mediaAssetId], references: [id])
  caption      String
  scheduledAt  DateTime
  status       JobStatus      @default(PENDING)
  approvalId   String?
  approval     Approval?      @relation(fields: [approvalId], references: [id])
  executedAt   DateTime?
  error        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, scheduledAt])
}
