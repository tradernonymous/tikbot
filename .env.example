# ==============================================================================
# TikBot Operator Environment Configuration Template
# ==============================================================================

# Core Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection
# Required in production; defaults to postgresql://postgres:postgres@localhost:5432/tikbot in dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tikbot

# Security & Cryptography
# MASTER_ENCRYPTION_KEY: Exactly 64-character hex string (32 bytes) used for AES-256-GCM vaults
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SESSION_SECRET: Minimum 32-character high-entropy secret for HMAC session tokens
# Generate with: openssl rand -base64 32
SESSION_SECRET=super-secret-session-key-minimum-32-chars-long-for-hmac

# Operator Authentication (Admin single-operator access)
# Either ADMIN_PASSWORD or OPERATOR_PASSWORD_HASH must be configured
ADMIN_PASSWORD=change-this-operator-password-in-production
# OPERATOR_PASSWORD_HASH=$scrypt$salt_hex$derived_key_hex

# Internal Webhooks & Inter-service Communication
# Minimum 16-character secret for internal job completion callbacks
INTERNAL_API_SECRET=super-internal-api-secret-16-chars-min

# SMM Wholesale Provider (Live Engagement Dispatch)
SMM_PROVIDER_URL=https://supplierfollower.com/api/v2
SMM_PROVIDER_API_KEY=your_supplierfollower_api_key_here

# Python Sidecar Integration (Transcription & Media Processing)
PYTHON_SIDECAR_URL=http://localhost:8000

# Storage Engine (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# S3 Compatible Storage (Required only if STORAGE_DRIVER=s3)
# S3_BUCKET=tikbot-assets
# S3_REGION=auto
# S3_ENDPOINT=https://your-r2-or-s3-endpoint.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Fleet Concurrency & Safety Controls
WORKER_CONCURRENCY=3
KILL_SWITCH_ACTIVE=false
